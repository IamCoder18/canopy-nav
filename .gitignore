# Logs
*.log
npm-debug.log*

# Dependencies
node_modules/

# Build output
dist/
android/app/build/
android/build/
android/.gradle/
android/app/src/main/assets/public/
android/local.properties
android/capacitor-capacitor-cordova-android-plugins/
.gradle/

# Capacitor / native generated
android/app/release/
*.keystore
!debug.keystore

# Editor / OS
.DS_Store
.idea/
.vscode/
*.iml

# Test artifacts
coverage/

# Never commit large map data or API keys
*.osm.pbf
*.osm
!test/fixture.osm
# ...and its PBF twin. These two are tiny hand-made fixtures, not map data, and
# tests/pbf.spec.ts asserts the XML and PBF readers agree on this exact file --
# which cannot work if CI has no PBF to read. Regenerate after changing the
# nanodegree encoding: `node tools/osm2pbf.mjs test/fixture.osm test/fixture.osm.pbf`
!test/fixture.osm.pbf
.env
.env.local
*.p12
e2e-screenshots/
# Any other .pbf under test/ stays ignored (regenerated downloads, scratch
# files). Must come after the negation above, hence the second one.
test/*.pbf
!test/fixture.osm.pbf
