{
  "name": "canopy-nav",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync": "npm run build && rm -rf android/app/src/main/assets/public && npx cap sync android",
    "apk": "npm run sync && cd android && JAVA_HOME=${JAVA_HOME:-/usr/lib/jvm/java-21-openjdk-amd64} ./gradlew assembleDebug",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 27",
    "lint:fix": "eslint . --fix",
    "lint:baseline": "eslint . 2>&1 | tail -3",
    "check": "npm run typecheck && npm run lint && npm test",
    "bundle": "node tools/bundle-budget.mjs",
    "e2e": "node test/e2e.mjs",
    "screens": "node test/screens.mjs",
    "serve": "node tools/serve.mjs",
    "focus": "node tools/focus.mjs",
    "shots": "node tools/shots.mjs",
    "reflow": "node tools/reflow.mjs",
    "reflow:note": "node tools/reflow.mjs || true",
    "swshell": "node tools/sw-shellcheck.mjs",
    "status": "node tools/status-audit.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "maplibre-gl": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
